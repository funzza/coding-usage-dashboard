{
  "name": "coding-usage-dashboard",
  "version": "0.2.0",
  "private": true,
  "description": "Windows desktop dashboard for local AI coding usage (ccusage, ZCode, DSH, Qoder) with subscription quota monitoring",
  "keywords": [
    "ccusage",
    "electron",
    "windows",
    "claude-code",
    "codex",
    "kimi",
    "grok",
    "token-usage"
  ],
  "homepage": "https://github.com/funzza/coding-usage-dashboard#readme",
  "bugs": {
    "url": "https://github.com/funzza/coding-usage-dashboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funzza/coding-usage-dashboard.git"
  },
  "license": "MIT",
  "author": "funzza",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder --publish never",
    "release": "npm run build && electron-builder --publish always",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "screenshot": "electron scripts/screenshot.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-echarts": "^8.1.0",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
